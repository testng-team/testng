<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<suite name="issue3111-script">
  <method-selectors>
    <method-selector>
      <script language="beanshell"><![CDATA[true]]></script>
    </method-selector>
  </method-selectors>
  <test name="selected factory instances under a script selector">
    <classes>
      <class name="test.factory.issue3111.ParallelFactorySample">
        <methods>
          <include name="test" factory-instances="1 3"/>
        </methods>
      </class>
    </classes>
  </test>
</suite>
