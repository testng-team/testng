<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="duplicate-includes">
  <test name="duplicate-includes">
    <classes>
      <class name="test.xml.duplicate.sample.DuplicateOccurrenceSample">
        <methods>
          <include name="f">
            <parameter name="id" value="one"/>
          </include>
          <include name="f">
            <parameter name="id" value="two"/>
          </include>
        </methods>
      </class>
    </classes>
  </test>
</suite>
