<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="duplicate-classes">
  <test name="duplicate-classes">
    <classes>
      <class name="test.xml.duplicate.sample.DuplicateOccurrenceSample">
        <parameter name="id" value="one"/>
        <methods>
          <include name="f"/>
        </methods>
      </class>
      <class name="test.xml.duplicate.sample.DuplicateOccurrenceSample">
        <parameter name="id" value="two"/>
        <methods>
          <include name="f"/>
        </methods>
      </class>
    </classes>
  </test>
</suite>
